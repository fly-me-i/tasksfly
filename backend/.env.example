# Copy this file to ".env" before running the server.
# Never commit your real .env file.

# Any long random string. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_string

# Port the backend server runs on.
PORT=4000

# Credentials for the FIRST admin account, created automatically
# the first time you start the server (only if no admin exists yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Where the admin gets emailed when a new signup picks their role and is
# ready for approval.
ADMIN_EMAIL=you@example.com

# SMTP settings for actually sending that email. Leave these blank and the
# app still works — it just prints the email to the backend's console
# instead of sending it, so you can test the whole approval flow with zero
# setup. Fill them in when you're ready for real emails.
#
# Easiest path for testing: a Gmail account with an "App Password"
# (myaccount.google.com/apppasswords — needs 2-Step Verification on first).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=the 16-character app password (not your normal Gmail password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional — defaults to using SMTP_USER as the "from" address
MAIL_FROM=

# The deployed frontend URL. Used for two things: (1) the link in the
# approval-request email points here, and (2) once set, the backend's CORS
# only accepts requests from this origin instead of any origin. Leave blank
# for local dev.
FRONTEND_URL=
