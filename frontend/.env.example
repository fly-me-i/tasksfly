# Copy this file to ".env" before building/running the frontend.
# Never commit your real .env file.

# URL of the deployed backend API, including the /api path.
# Local dev needs zero setup - api.js falls back to http://localhost:4000/api
# if this is unset. Once you deploy, this MUST point at your real backend,
# e.g. https://tasksfly-backend.onrender.com/api
VITE_API_URL=
